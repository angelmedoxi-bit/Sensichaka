    UDim.new(0,12)

local active = false

button.MouseButton1Click:Connect(function()
    active = not active

    button.Text = active
        and "DETECTAR ENEMIGOS: ON"
        or "DETECTAR ENEMIGOS: OFF"

    button.BackgroundColor3 = active
        and Color3.fromRGB(130,0,0)
        or Color3.fromRGB(40,40,40)

    if active then
        print("Enemigos detectados:", #ObtenerEnemigos())
    end
end)

